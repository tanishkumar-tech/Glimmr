# Copy this file to `.env` and fill in values before running backend
# Recommended: set a MONGO_URI that points to a secure Atlas connection or local MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/glimmr
JWT_SECRET=replace_with_a_strong_secret
JWT_EXPIRES_IN=7d
# Optional: Firebase service account key JSON string (single-line) or path to file
# FIREBASE_SERVICE_ACCOUNT_KEY={...}
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# SMTP settings for email OTPs (optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=secret
# SMTP_SECURE=false
